# =============================================================================
# Prism — 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# docker-compose.dev.yml 中所有服务通过 env_file 加载此配置
# =============================================================================

# ── Supabase（认证 & 数据库） ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# PostgreSQL 连接字符串（不设置则 server 使用内存仓储，ai 使用 mock 搜索）
DATABASE_URL=postgresql://postgres:password@db:5432/prism?sslmode=disable

# JWT 验证（通常自动从 SUPABASE_URL 推导，如需覆盖可手动设置）
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated

# ── Web 前端 ──────────────────────────────────────────────────────────────────
SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# ── Go 后端 ───────────────────────────────────────────────────────────────────
PORT=8080
AI_SERVICE_URL=http://ai:5000
CORS_ORIGIN=http://localhost:3000

# Supabase Storage（作业图片上传）
SUPABASE_STORAGE_BUCKET=homework-images
SUPABASE_STORAGE_PUBLIC_BASE_URL=https://your-project.supabase.co/storage/v1/object/public

# ── AI 服务 ───────────────────────────────────────────────────────────────────
# 供应商（openrouter | openai）
AI_PROVIDER=openrouter

# OpenRouter（默认）
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_REFERER=https://prism.local

# OpenAI（AI_PROVIDER=openai 时使用）
# OPENAI_API_KEY=sk-...

# 按任务指定模型
MODEL_CHAT=anthropic/claude-sonnet-4
MODEL_VISION=openai/gpt-4o
MODEL_EMBEDDING=openai/text-embedding-3-small
