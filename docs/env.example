# Prism 环境变量样例

# Shared
PRISM_ENV=development # reserved (not wired yet)
PRISM_PRIVACY_ACK_VERSION=2026-03-04

# BFF
BFF_PORT=8787
BFF_REQUIRE_AUTH=true
BFF_JWT_LEEWAY_SECONDS=60
BFF_SQLITE_PATH=apps/bff/data/prism.db
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_PROJECT_REF= # reserved (not wired yet)

# Provider
PROVIDER_MODE=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TUTOR_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini

# Web
VITE_BFF_BASE_URL=http://127.0.0.1:8787
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PRIVACY_ACK_VERSION=2026-03-04 # reserved (not wired yet)

# Desktop
TAURI_DEV_HOST=http://127.0.0.1:5173 # reserved (not wired yet)

# 校验规则说明
# 代码实际读取变量必须全部存在于本文件；预留变量必须带 reserved 注释。

