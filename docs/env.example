# Prism 环境变量样例

# Shared
PRISM_ENV=development
PRISM_PRIVACY_ACK_VERSION=2026-03-04

# BFF
BFF_PORT=8787
BFF_REQUIRE_AUTH=true
BFF_JWT_LEEWAY_SECONDS=60
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_PROJECT_REF=

# Provider
PROVIDER_MODE=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TUTOR_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini

# Web
VITE_BFF_BASE_URL=http://127.0.0.1:8787
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PRIVACY_ACK_VERSION=2026-03-04

# Desktop
TAURI_DEV_HOST=http://127.0.0.1:5173
